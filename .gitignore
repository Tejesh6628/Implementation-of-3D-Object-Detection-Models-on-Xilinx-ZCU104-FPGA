complex_yolov4/velodyne/testing_set/
second_model/calib_data_real/
second_model/calib_data_test/

# Vitis AI temporary dump logs and profiling traces
*.log
quantize_result/
dump_results/
*.wdb
*.wcfg

# Redundant duplicate compilation build
ZYNQ/compiled_qat_1/
complex_yolov4/compiled_qat/*.xmodel

